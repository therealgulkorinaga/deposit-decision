{
  "name": "deposit-decision",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 5173",
    "build": "next build",
    "lint": "oxlint",
    "test": "node --conditions=react-server --import tsx --test tests/*.test.ts",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "env:check": "node --conditions=react-server --import tsx scripts/env-check.ts",
    "db:init": "node --conditions=react-server --import tsx scripts/db-init.ts",
    "check:client": "node --import tsx scripts/check-client-bundle.ts",
    "typecheck": "tsc --noEmit",
    "ingest": "node --conditions=react-server --import tsx scripts/ingest.ts",
    "seed:public": "node --conditions=react-server --import tsx scripts/seed-public.ts",
    "graph": "node --conditions=react-server --import tsx scripts/decision-graph.ts",
    "flow:inspect": "node --conditions=react-server --import tsx scripts/flow-inspect.ts"
  },
  "dependencies": {
    "@next/env": "^16.3.8",
    "cheerio": "^1.2.0",
    "next": "^16.3.8",
    "openai": "^7.27.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
